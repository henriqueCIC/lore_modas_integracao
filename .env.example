# Copie os valores para o ambiente do servidor; não versione o arquivo .env.
ADMIN_PASSWORD=troque-por-uma-senha-longa
DB_PATH=./data/fantasias.sqlite
PORT=3000
NODE_ENV=development
TRUST_LOCAL_PROXY=0

# Integrações opcionais para ambiente de teste
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback opcional (lista separada por vírgula) se o modelo principal retornar 429/503:
# GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.8-flash,gemini-3.6-flash
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_CONFIRMATION_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=
